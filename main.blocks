d c " line38="                c d d d b d d b d d d d b d d c " line39="                c d d d b d d b d d d d b d d c " line40="                c b d d d b d b d d d b d d d c " line41="                c d b b d d b d d d d b d d d c " line42="                c d d d b d b b d d d b d d d c " line43="                c d d d d b b d b d b d d d d c " line44="                c d d d d b d b d b b d d d d c " line45="                c d d d b d d d b b b d d d d c " line46="                c d d d b d d d d d b d d d d c " line47="                c d d d b d d d d b d b b d d c " line48="                c d d b d d d d d b d d d b d c " line49="                c c c c c c c c c c c c c c c c " line50="                ` }," line51="        Wood: {" line52="            isWall: false, image: img`" line53="                . e e e e e e e e e e e e e e . " line54="                . e e e e e e e e e e e e e e . " line55="                . e e e e e e e e e e e e e e . " line56="                . e e e e e e e e e e e e e e . " line57="                . e e e e e e e e e e e e e e . " line58="                . e e e e e e e e e e e e e e . " line59="                . e e e e e e e e e e e e e e . " line60="                . e e e e e e e e e e e e e e . " line61="                . e e e e e e e e e e e e e e . " line62="                . e e e e e e e e e e e e e e . " line63="                . e e e e e e e e e e e e e e . " line64="                . e e e e e e e e e e e e e e . " line65="                . e e e e e e e e e e e e e e . " line66="                . e e e e e e e e e e e e e e . " line67="                . e e e e e e e e e e e e e e . " line68="                . e e e e e e e e e e e e e e . " line69="                ` }," line70="        Gold: {" line71="            isWall: true, image: img`" line72="                c c c c c c c c c c c c c c c c " line73="                c b d d d d d d d b d d d d d c " line74="                c d b d d 5 5 5 b d d d d b d c " line75="                c d d b d 5 5 5 b d d d b d d c " line76="                c 5 5 d b d d b d d 5 d b d d c " line77="                c 5 d d b d d b d d 5 5 b d d c " line78="                c b d d d b d b d d 5 5 d d d c " line79="                c d b b d d 5 d d d 5 5 d d d c " line80="                c d d d b d 5 b d d 5 b d 5 d c " line81="                c d 5 5 5 b 5 5 b d b d d 5 5 c " line82="                c d d d d b d b d b b d d 5 5 c " line83="                c d d d b d d d b b b d d d d c " line84="                c 5 d d b d d d 5 5 5 5 5 5 d c " line85="                c 5 d d b d d d 5 5 5 5 5 d d c " line86="                c 5 d b d d d d d b d d d b d c " line87="                c c c c c c c c c c c c c c c c " line88="                ` }," line89="        Dirt: {" line90="            isWall: true, image: img`" line91="                e e e e e e e e e e e e e e e e " line92="                e e e e e e e e e f e e e e e e " line93="                e e e e e e e e e e e e e e e e " line94="                e e e e e e e f e e e e e e e e " line95="                e e e e f e e e e e e e e e e f " line96="                e e e e e e e e e e e e e e e e " line97="                e e e e e e e e e e e e e e e e " line98="                e e e e e e e e f e e f e e e e " line99="                e e e e e f e e e e e e e e e e " line100="                e e e e e e e e e e e e e e e e " line101="                e e e e e e e e e e e e e e e e " line102="                e e e e e e e e f e e e e e e e " line103="                e e e e e e e e e e e e e e e e " line104="                e e e e e e e e e e e e e e e e " line105="                e e e e e e e e e e e e e e e e " line106="                e e e e e e e e e e e e e e e e " line107="                ` }," line108="        Grass: {" line109="            isWall: true, image: img`" line110="                7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 " line111="                7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 " line112="                7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 " line113="                e e e e e e e e e e e e e e e e " line114="                e e e f e e e e e e e e e e e e " line115="                e e e e e e e e e e e e f e e e " line116="                e e e e e f e e f e e e e e e e " line117="                e f e e e e e e e e e e e e e e " line118="                e e e e e e e e e e e f e e f f " line119="                e e e f e f e e e e e e e e e e " line120="                e e e e e e e e e e e e e e e e " line121="                e e e e e e e e f e e e e f e e " line122="                e e e e e e e e e e e e e e e e " line123="                e f e e e f e e e e e e e e e e " line124="                e e e e e e e e e f e e e e e e " line125="                e e e e e e e e e e e e e e e e " line126="                ` }," line127="    };" line128="" line129="    _image: Image;" line130="    _isWall: boolean;" line131="    _blockType: keyof typeof Block.BlockType;" line132="    _x: number;" line133="    _y: number;" line134="    _location: tiles.Location;" line135="    _chank: Chank;" line136="    constructor(chank: Chank, blockType?: keyof typeof Block.BlockType, location?: tiles.Location) {" line137="        // Если не указан тип, то это воспринимается как пустота, система не позволяет указать вариант по-умолчанию" line138="        if (blockType == undefined) {" line139="            blockType = &quot;Empty&quot;;" line140="        }" line141="        // Проверяем наличие указанного типа, если нету, возвращаем ошибку" line142="        const config = Block.blockConfigs[blockType]; //" line143="" line144="        this._location = location ? location : tiles.getTileLocation(0, 0);" line145="" line146="        this._blockType = blockType;" line147="        this._isWall = config.isWall;" line148="        this._image = config.image;" line149="" line150="        this._chank = chank;" line151="" line152="        // Рендерим блок с использованием стандартных функций" line153="        tiles.setTileAt(this._location, this._image);" line154="    }" line155="" line156="    // Воруем все функции из tilemap и добавляем свои" line157="" line158="    // Известно что за объект добыт" line159="" line160="    // Проверка принадлежности выбранных координат к группе блоков в указанном радиусе" line161="    checkDistance = (targetLocation: tiles.Location, radius?: number, myLocation?: tiles.Location) =&gt; {" line162="        // Проверка инициализации персонажа (если нет, то берутся координаты 0,0)" line163="        let { column, row } = myLocation ? myLocation : tiles.getTileLocation(0, 0);" line164="        // Проверка заполнения radius" line165="        let _radius = radius ? radius : 4;  " line166="        // Проверяем диапазон тайлов в указанном радиусе (проверяем isWall, т.к. у истинно пустых координат не будет этого параметра)" line167="        for (let y = row - _radius; y &lt; row + _radius; y++) {" line168="            for (let x = column - _radius; x &lt; column + _radius; x++) {" line169="                console.log(tiles.tileAtLocationIsWall(tiles.getTileLocation(x, y)));" line170="                return tiles.tileAtLocationIsWall(tiles.getTileLocation(x, y)) != undefined;" line171="            }" line172="        }" line173="        return false;" line174="    }" line175="" line176="    // Установка блоков" line177="    createBlock(location: tiles.Location, blockType: keyof typeof Block.BlockType) {" line178="        let isMatch = this.checkDistance(location, 4); // Наличие в радиусе 4 клеток" line179="" line180="        if (isMatch) {" line181="            // Проверка пустой ли блок" line182="            const block = this._chank.getBlock(location);" line183="            if (block.isWall) {" line184="                block.blockType = blockType;" line185="            };" line186="            tiles.setWallAt(location, true);" line187="            tiles.setTileAt(location, assets.tile`myTile0`);" line188="        }" line189="    }" line190="" line191="    " line192="" line193="    // Чтение и установка параметра &quot;Стена&quot;" line194="    get isWall() {" line195="        return this._isWall;" line196="    }" line197="    set isWall(value: boolean) {" line198="        this._isWall = value;" line199="    }" line200="" line201="    get blockType() {" line202="        return this._blockType;" line203="    }" line204="    set blockType(value: keyof typeof Block.BlockType) {" line205="        this._blockType = value;" line206="    }" line207="}" numlines="208"></mutation><next><block type="typescript_statement" id="06$Ejcal`NQzvLmqYu3G" editable="false"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Chank {" line1="    _width: number;" line2="    _height: number;" line3="    _map: Array&lt;Array&lt;Block&gt;&gt;;" line4="    _startLocation: tiles.Location;" line5="    _endLocation: tiles.Location;" line6="" line7="    constructor(width: number = 2, height: number = 2) {" line8="        this._width = width;" line9="        this._height = height;" line10="        // Генерация карты заданного размера из блоков &quot;воздуха&quot;" line11="        this._map = this.generateEmptyMap();" line12="    }" line13="    " line14="    generateEmptyMap() {" line15="        const array = [];" line16="        for (let y2 = 0; y2 &lt; this._height; y2++) {" line17="            const row = [];" line18="            for (let x2 = 0; x2 &lt; this._width; x2++) {" line19="                row.push(new Block(this, &quot;Stone&quot;, tiles.getTileLocation(x2, y2)));" line20="            }" line21="            array.push(row);" line22="        }" line23="        return array;" line24="    }" line25="" line26="    getBlock(location: tiles.Location) {" line27="        const { column, row } = location;" line28="" line29="        return this._map[row][column];" line30="    }" line31="" line32="    get width() {" line33="        return this._width;" line34="    }" line35="    get height() {" line36="        return this._height;" line37="    }" line38="    set width(value: number) {" line39="        this._width = value;" line40="    }" line41="    set height(value: number) {" line42="        this._height = value;" line43="    }" line44="" line45="    // Метод проверки принадлежности к диапазону" line46="    " line47="    // Генерация без накладывания (точный подсчет кол-ва)" line48="    // Текучие блоки" line49="}" numlines="50"></mutation><next><block type="gamesetbackgroundimage" id="^m-u_Ei$Pu(KAWk%N[jJ"><comment pinned="false" h="80" w="160">НАСТРОЙКИ ИГРЫ (константы)
ИНИЦИАЛИЗАЦИЯ ИГРЫ
Задаем фоновую картинку уровня вместо черноты</comment><value name="img"><shadow type="background_image_picker" id="0r/A`FAFafWGqcp?7(Lk"><field name="img">img`
